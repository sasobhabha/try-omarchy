TRYOMARCHY_HAS_ZSTD = 0
TRYOMARCHY_ZSTD_HEADERS =
TRYOMARCHY_ZSTD_LIBS =
TRYOMARCHY_EXTRA_LDFLAGS =
#include? "Runtime.local.xcconfig"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) TRYOMARCHY_HAS_ZSTD=$(TRYOMARCHY_HAS_ZSTD)
HEADER_SEARCH_PATHS = $(inherited) $(TRYOMARCHY_ZSTD_HEADERS)
LIBRARY_SEARCH_PATHS = $(inherited) $(TRYOMARCHY_ZSTD_LIBS)
USER_HEADER_SEARCH_PATHS = $(SRCROOT)/runtime/jit $(SRCROOT)/runtime/support $(inherited)
OTHER_LDFLAGS = $(inherited) -framework Security $(TRYOMARCHY_EXTRA_LDFLAGS)
