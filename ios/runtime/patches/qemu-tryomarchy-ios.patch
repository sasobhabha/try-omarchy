diff -ruN a/system/main.c b/system/main.c
--- a/system/main.c	2026-10-25 23:24:07
+++ b/system/main.c	2026-10-25 23:24:07
@@ -41,6 +41,39 @@
 #include <CoreFoundation/CoreFoundation.h>
 #endif
 
+#ifdef CONFIG_TRYOMARCHY_IOS
+/*
+ * StikDebug grants JIT to this process, and iOS refuses to spawn another
+ * one. The app calls tryomarchy_qemu_start on a background thread and
+ * returns when the guest shuts down, so the main thread stays with the app.
+ */
+int tryomarchy_qemu_start(int argc, char **argv)
+{
+    int status;
+
+    qemu_init(argc, argv);
+    bql_unlock();
+    replay_mutex_unlock();
+    replay_mutex_lock();
+    bql_lock();
+    status = qemu_main_loop();
+    qemu_cleanup(status);
+    bql_unlock();
+    replay_mutex_unlock();
+    return status;
+}
+
+int tryomarchy_qemu_runtime_present(void)
+{
+    return 1;
+}
+
+__attribute__((weak))
+int main(int argc, char **argv)
+{
+    exit(tryomarchy_qemu_start(argc, argv));
+}
+#else
 static void *qemu_default_main(void *opaque)
 {
     int status;
@@ -94,3 +127,4 @@
         g_assert_not_reached();
     }
 }
+#endif
