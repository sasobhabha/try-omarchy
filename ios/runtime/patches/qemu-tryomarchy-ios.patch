+        if (allocated == NULL) {
+            error_setg(errp, "The debugger did not allocate the translator region");
+            return -1;
+        }
+        buf_rx = (mach_vm_address_t)allocated;
+        buf_rw = 0;
+        ret = mach_vm_remap(mach_task_self(),
