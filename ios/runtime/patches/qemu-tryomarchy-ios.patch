+#ifdef CONFIG_TRYOMARCHY_IOS
+    /*
+     * iOS 26's TXM keeps a mapping executable only when the attached
+     * debugger allocated it. One region is prepared, then the script is
+     * detached; a later region cannot be prepared. A null address asks
+     * the debugger to allocate. An address this process mapped is not
